CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xc000

# OTA rollback: a bad firmware is reverted if it cannot reach the cloud
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# BLE provisioning + assisted claiming from the RainMaker phone app
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3120
CONFIG_ESP_RMAKER_USER_ID_CHECK=y

# app_network_start() must return immediately so monitoring keeps running while Wi-Fi is down
CONFIG_APP_NETWORK_ASYNCHRONOUS_CONNECTION=y

# Espressif Insights over the RainMaker MQTT connection
CONFIG_ESP_INSIGHTS_ENABLED=y
CONFIG_ESP_INSIGHTS_TRANSPORT_MQTT=y
CONFIG_ESP_INSIGHTS_CMD_RESP_ENABLED=y
CONFIG_DIAG_ENABLE_METRICS=y
CONFIG_DIAG_ENABLE_HEAP_METRICS=y
CONFIG_DIAG_ENABLE_WIFI_METRICS=y
CONFIG_DIAG_ENABLE_VARIABLES=y
CONFIG_DIAG_ENABLE_NETWORK_VARIABLES=y
CONFIG_APP_INSIGHTS_ENABLE_LOG_TYPE_ALL=y

# Allows esp_log_level_set() to raise the provisioning logs to DEBUG
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
